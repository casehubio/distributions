<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.casehub</groupId>
        <artifactId>casehub-parent</artifactId>
        <version>0.4-SNAPSHOT</version>
    </parent>

    <artifactId>casehub-distributions-parent</artifactId>
    <packaging>pom</packaging>
    <name>CaseHub Distributions</name>
    <description>Leaf apps and packaged deployables — MCP server, CLI tools, Electron app.
        Each module is a thin assembly wiring upstream platform modules into a runnable application.</description>

    <properties>
        <quarkus.version>${quarkus.platform.version}</quarkus.version>
    </properties>

    <modules>
        <module>mcp-server</module>
    </modules>

    <scm>
        <connection>scm:git:https://github.com/casehubio/distributions.git</connection>
        <developerConnection>scm:git:https://github.com/casehubio/distributions.git</developerConnection>
        <url>https://github.com/casehubio/distributions</url>
    </scm>

    <repositories>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/casehubio/*</url>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/casehubio/distributions</url>
        </repository>
    </distributionManagement>
</project>
